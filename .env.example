STORAGE_ROOT=$(pwd)/storage
HF_HOME=${STORAGE_ROOT}/hf_cache
TRANSFORMERS_CACHE=${STORAGE_ROOT}/hf_cache
HUGGINGFACE_HUB_CACHE=${STORAGE_ROOT}/hf_cache
TORCH_HOME=${STORAGE_ROOT}/torch_cache
TMPDIR=${STORAGE_ROOT}/tmp
PIP_CACHE_DIR=${STORAGE_ROOT}/pip_cache

# --- detector ---
# HuggingFace repo id (or a local .pt path) for the YOLOv8 weights.
# yolov8n_sku: single-class ("Item") YOLOv8-nano fine-tuned on the real
# SKU-110K dataset (11.7k images, mAP@0.5=0.90). Boxes individual product
# facings instead of whole stacks/brands.
DETECTOR_MODEL=${STORAGE_ROOT}/weights/yolov8n_sku.pt
DETECTOR_MODEL_FILE=best.pt
DETECTOR_CONF=0.25
DETECTOR_IOU=0.45
DETECTOR_IMGSZ=1024
DETECTOR_MAX_DET=1000

# post-processing: dedupe (same product boxed 2-3x / nested boxes)
DETECTOR_DEDUPE_ENABLED=true
# if a smaller box's intersection with a larger box exceeds this fraction
# of the SMALLER box's own area, the smaller box is dropped as a duplicate.
DETECTOR_CONTAINMENT_IOU=0.7

# post-processing: price-tag filtering. method = none | geometry | clip
DETECTOR_PRICE_TAG_METHOD=none
# geometry method: flag boxes wider than this aspect ratio AND shorter
# than this fraction of the image height as price tags.
DETECTOR_PRICE_TAG_MAX_ASPECT_RATIO=3.0
DETECTOR_PRICE_TAG_MAX_HEIGHT_FRAC=0.05
# clip method: zero-shot "price tag" vs "product package" prompt; drop if
# P(price tag) exceeds this.
DETECTOR_PRICE_TAG_CLIP_MODEL=openai/clip-vit-base-patch32
DETECTOR_PRICE_TAG_CLIP_THRESHOLD=0.6

# debug: save before/after box visualizations for every /detect call
DETECTOR_DEBUG_SAVE=false
DETECTOR_DEBUG_DIR=outputs/debug

# --- grouping ---
GROUPING_MODEL=openai/clip-vit-base-patch32
# Cosine distance threshold for agglomerative clustering. Lower = stricter
# (more, smaller groups). Higher = looser (fewer, bigger groups).
GROUPING_DISTANCE_THRESHOLD=0.3

# --- gateway ---
# Service URLs the gateway calls.
DETECTOR_URL=http://localhost:8001
GROUPING_URL=http://localhost:8002
SERVICE_TIMEOUT=60
MAX_UPLOAD_MB=20
GATEWAY_PORT=8000
